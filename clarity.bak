        <script>
            // Configuration for two demos
            const demo1Config = {
                folder: '000',
                numImages: 6,
                images: [],
                currentFrame: 0,
                scrollAccumulator: 0
            };

            const demo2Config = {
                folder: '001',
                numImages: 8,
                images: [],
                currentFrame: 0,
                scrollAccumulator: 0
            };

            const scrollSensitivity = 200; // Adjust for scroll sensitivity

            // Preload images for both demos
            function preloadDemoImages(config) {
                for (let i = 0; i < config.numImages; i++) {
                    const img = new Image();
                    const frameNum = i.toString().padStart(3, '0');
                    img.src = `teaser_imgs/${config.folder}/${frameNum}.png`;
                    config.images.push(img);
                }
            }

            preloadDemoImages(demo1Config);
            preloadDemoImages(demo2Config);

            // Handle scroll for a demo
            function handleDemoScroll(e, config, imageElementId) {
                e.preventDefault();
                
                config.scrollAccumulator += e.deltaY;

                if (config.scrollAccumulator >= scrollSensitivity) {
                    // Scrolled DOWN - go to next frame
                    let nextFrame = Math.min(config.numImages - 1, config.currentFrame + 1);
                    if (nextFrame !== config.currentFrame) {
                        config.currentFrame = nextFrame;
                        document.getElementById(imageElementId).src = config.images[config.currentFrame].src;
                        config.scrollAccumulator = 0;
                    } else {
                        config.scrollAccumulator = scrollSensitivity;
                    }
                } else if (config.scrollAccumulator <= -scrollSensitivity) {
                    // Scrolled UP - go to previous frame
                    let nextFrame = Math.max(0, config.currentFrame - 1);
                    if (nextFrame !== config.currentFrame) {
                        config.currentFrame = nextFrame;
                        document.getElementById(imageElementId).src = config.images[config.currentFrame].src;
                        config.scrollAccumulator = 0;
                    } else {
                        config.scrollAccumulator = -scrollSensitivity;
                    }
                }
            }

            // Attach scroll listeners
            document.getElementById('demo1-scroll-area').addEventListener('wheel', function(e) {
                handleDemoScroll(e, demo1Config, 'demo1-image');
            }, { passive: false });

            document.getElementById('demo2-scroll-area').addEventListener('wheel', function(e) {
                handleDemoScroll(e, demo2Config, 'demo2-image');
            }, { passive: false });

            // --- Synchronized Scroll Hint Overlay Logic ---
            (function() {
                const scrollAreas = [
                    document.getElementById('demo1-scroll-area'),
                    document.getElementById('demo2-scroll-area')
                ];
                const hints = [
                    document.getElementById('demo1-hint'),
                    document.getElementById('demo2-hint')
                ];
                let inactivityTimer = null;

                function showHints() {
                    hints.forEach(function(h) { h.classList.add('visible'); });
                }

                function hideHints() {
                    hints.forEach(function(h) { h.classList.remove('visible'); });
                }

                function resetInactivityTimer() {
                    if (inactivityTimer) clearTimeout(inactivityTimer);
                    hideHints();
                    inactivityTimer = setTimeout(showHints, 3000);
                }

                scrollAreas.forEach(function(area) {
                    area.addEventListener('mousemove', resetInactivityTimer);
                    area.addEventListener('wheel', resetInactivityTimer);
                });

                // Show hints on initial load
                showHints();
            })();
        </script>

        <style>
            .scroll-hint-overlay {
                position: absolute;
                top: 0; left: 0;
                width: 100%; height: 100%;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                background: rgba(0, 0, 0, 0.35);
                z-index: 15;
                pointer-events: none;
                opacity: 0;
                transition: opacity 0.25s ease;
                border-radius: 4px;
            }
            .scroll-hint-overlay.visible {
                opacity: 1;
            }
            .scroll-hint-overlay span {
                color: #fff;
                font-size: 14px;
                font-weight: 600;
                margin-top: 10px;
                letter-spacing: 0.5px;
                text-shadow: 0 1px 4px rgba(0,0,0,0.4);
            }
            .scroll-hint-icon {
                display: flex;
                align-items: center;
                gap: 8px;
                color: #fff;
                font-size: 28px;
                filter: drop-shadow(0 1px 4px rgba(0,0,0,0.4));
                animation: hintBounce 1s ease-in-out;
            }
            .scroll-hint-arrows {
                display: flex;
                flex-direction: column;
                font-size: 16px;
                gap: 2px;
            }
            @keyframes hintBounce {
                0%, 100% { transform: translateY(0); }
                25% { transform: translateY(-6px); }
                50% { transform: translateY(0); }
                75% { transform: translateY(6px); }
            }
        </style>

